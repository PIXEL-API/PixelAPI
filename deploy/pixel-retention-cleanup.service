[Unit]
Description=Remove expired Pixel release and upload artifacts
After=local-fs.target pixel.service
ConditionPathIsDirectory=/opt/sub2api/releases

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pixel-retention-cleanup
User=root
Group=root
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sub2api/releases /opt/sub2api/release-maintenance /run
