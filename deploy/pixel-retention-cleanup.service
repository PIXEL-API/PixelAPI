[Unit]
Description=Remove expired Pixel release and upload artifacts
After=local-fs.target pixel.service
ConditionPathIsDirectory=/opt/sub2api/releases
ConditionPathIsDirectory=/home/pixel/sub2api_release_uploads

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pixel-retention-cleanup
User=root
Group=root
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/sub2api/releases /home/pixel/sub2api_release_uploads /run
