[Unit]
Description=Sub2API Cluster Application Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sub2api
Group=sub2api
WorkingDirectory=/opt/sub2api/current
ExecStart=/opt/sub2api/current/sub2api
EnvironmentFile=/etc/sub2api/cluster.env
EnvironmentFile=/etc/sub2api/node.env
Restart=on-failure
RestartSec=5s
TimeoutStopSec=360s
LimitNOFILE=100000
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sub2api

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sub2api
RuntimeDirectory=sub2api
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
